# "live" (default) talks to the backend through the /api/v1 proxy.
# "mock" uses an in-memory dev adapter and shows a "Mock data" badge. Local UI work only.
NEXT_PUBLIC_API_MODE=live

# Where Next.js proxies /api/v1/* (server-side only).
BACKEND_URL=http://localhost:8000

# Max upload sizes enforced client-side before upload (server must enforce too).
NEXT_PUBLIC_MAX_ZIP_MB=500
NEXT_PUBLIC_MAX_APK_MB=200
