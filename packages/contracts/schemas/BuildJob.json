{
  "$defs": {
    "BuildVariant": {
      "enum": [
        "debug",
        "release"
      ],
      "title": "BuildVariant",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "API/orchestration -> android-build worker. Owner: Person 4.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "source_key": {
      "title": "Source Key",
      "type": "string"
    },
    "variant": {
      "$ref": "#/$defs/BuildVariant",
      "default": "debug"
    },
    "gradle_tasks": {
      "items": {
        "type": "string"
      },
      "title": "Gradle Tasks",
      "type": "array"
    },
    "timeout_seconds": {
      "default": 900,
      "exclusiveMinimum": 0,
      "title": "Timeout Seconds",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "source_key"
  ],
  "title": "BuildJob",
  "type": "object"
