# Copy to .env and fill in. NEVER commit real values.
# Required values are validated on API startup; startup fails if they are missing.

# --- Application ---
ENVIRONMENT=development          # development | test | production
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (PostgreSQL) --- REQUIRED
POSTGRES_USER=androai
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=androai
DATABASE_URL=postgresql://androai:change-me-postgres@localhost:5432/androai

# --- Redis --- REQUIRED
REDIS_URL=redis://localhost:6379/0

# --- JWT --- REQUIRED (>= 32 chars; generate: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-generate-a-long-random-secret-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30

REFRESH_TTL_DAYS=30
# Fernet key for secrets stored in the DB. generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
TRUST_PROXY_HEADERS=false

# --- Email (console = dev only, logs one-time links) ---
EMAIL_BACKEND=console
EMAIL_FROM=AndroAI <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Uploads ---
UPLOAD_MAX_BYTES=209715200
UPLOAD_MAX_UNCOMPRESSED_BYTES=1073741824
UPLOAD_MAX_FILES=20000

# --- AI providers (optional until AI modules land) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Object storage (S3-compatible; optional until storage module lands) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./.data/storage

# --- Workers ---
WORKER_CONCURRENCY=2
